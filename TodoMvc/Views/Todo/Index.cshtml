@model List<TodoMvc.Models.TodoItem>

<h1>Todo List</h1>
<a asp-action="Create">Add New Todo</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Is Complete</th>
            <th>Created At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.IsComplete</td>
                <td>@item.CreatedAt</td>
            </tr>
        }
    </tbody>
</table>
